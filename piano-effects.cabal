cabal-version:      3.0
name:               piano-effects
version:            0.1.0.0
synopsis:           dsp effects for midi keyboard

license:            BSD-3-Clause
license-file:       LICENSE
                    
author:             Miguel Laredo
maintainer:         miguellaredobarbadillo@gmail.com
category:           Sound
                    
build-type:         Simple
extra-doc-files:    CHANGELOG.md

common warnings
    ghc-options: -Wall

executable piano-effects
    import:           warnings
    main-is:          Main.hs
    build-depends:    base ^>=4.18.3.0,
                      haskell-say ^>=1.0.0.0,
                      PortMidi ^>=0.2.0.1
    hs-source-dirs:   app
    default-language: Haskell2010
